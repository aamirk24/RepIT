APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///repit.db

# Production-only settings
PROXY_FIX_HOPS=1
LOG_FORMAT=json
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Optional error monitoring. Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
